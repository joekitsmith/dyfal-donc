{
  "components": {
    "schemas": {
      "AudioLinks": {
        "description": "Where to fetch each track of an exercise, as paths on this API.",
        "properties": {
          "english": {
            "title": "English",
            "type": "string"
          },
          "welsh": {
            "title": "Welsh",
            "type": "string"
          },
          "welsh_slow": {
            "title": "Welsh Slow",
            "type": "string"
          }
        },
        "required": [
          "english",
          "welsh",
          "welsh_slow"
        ],
        "title": "AudioLinks",
        "type": "object"
      },
      "AudioTrack": {
        "description": "What can be heard for an exercise: the English prompt, then the Welsh twice.",
        "enum": [
          "english",
          "welsh",
          "welsh-slow"
        ],
        "title": "AudioTrack",
        "type": "string"
      },
      "AuthenticationVerifyRequest": {
        "description": "The browser's signed answer, as its WebAuthn API produced it.",
        "properties": {
          "credential": {
            "$ref": "#/components/schemas/PasskeyJson"
          }
        },
        "required": [
          "credential"
        ],
        "title": "AuthenticationVerifyRequest",
        "type": "object"
      },
      "CourseResponse": {
        "properties": {
          "item_count": {
            "title": "Item Count",
            "type": "integer"
          },
          "release": {
            "title": "Release",
            "type": "string"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/TopicResponse"
            },
            "title": "Topics",
            "type": "array"
          }
        },
        "required": [
          "release",
          "item_count",
          "topics"
        ],
        "title": "CourseResponse",
        "type": "object"
      },
      "ExercisePurpose": {
        "description": "Why an exercise was chosen.",
        "enum": [
          "learning_due",
          "review_due",
          "introduction",
          "practice"
        ],
        "title": "ExercisePurpose",
        "type": "string"
      },
      "ExerciseResponse": {
        "description": "An exercise to do. Quote ``selection_id`` back when reporting the outcome.",
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/AudioLinks"
          },
          "english": {
            "title": "English",
            "type": "string"
          },
          "introduces": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Introduces"
          },
          "item_ids": {
            "items": {
              "type": "string"
            },
            "title": "Item Ids",
            "type": "array"
          },
          "kind": {
            "const": "exercise",
            "default": "exercise",
            "title": "Kind",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ExercisePurpose"
          },
          "selection_id": {
            "format": "uuid",
            "title": "Selection Id",
            "type": "string"
          },
          "welsh": {
            "title": "Welsh",
            "type": "string"
          }
        },
        "required": [
          "selection_id",
          "english",
          "welsh",
          "audio",
          "item_ids",
          "introduces",
          "purpose"
        ],
        "title": "ExerciseResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "NextExerciseResponse": {
        "discriminator": {
          "mapping": {
            "exercise": "#/components/schemas/ExerciseResponse",
            "nothing_eligible": "#/components/schemas/NothingEligibleResponse"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/ExerciseResponse"
          },
          {
            "$ref": "#/components/schemas/NothingEligibleResponse"
          }
        ]
      },
      "NothingEligibleResponse": {
        "description": "There is no exercise to give: the course has a gap or is empty.",
        "properties": {
          "kind": {
            "const": "nothing_eligible",
            "default": "nothing_eligible",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "NothingEligibleResponse",
        "type": "object"
      },
      "OutcomeRequest": {
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/ReportedOutcome"
          },
          "selection_id": {
            "format": "uuid",
            "title": "Selection Id",
            "type": "string"
          }
        },
        "required": [
          "selection_id",
          "outcome"
        ],
        "title": "OutcomeRequest",
        "type": "object"
      },
      "OutcomeResponse": {
        "description": "``recorded`` is false when this outcome had already been recorded.",
        "properties": {
          "recorded": {
            "title": "Recorded",
            "type": "boolean"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": [
          "sequence",
          "recorded"
        ],
        "title": "OutcomeResponse",
        "type": "object"
      },
      "PasskeyJson": {
        "additionalProperties": true,
        "type": "object"
      },
      "PasskeyResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          }
        },
        "required": [
          "id",
          "label",
          "created_at",
          "last_used_at"
        ],
        "title": "PasskeyResponse",
        "type": "object"
      },
      "ProgressResponse": {
        "description": "Where the learner is, as of the server's clock.",
        "properties": {
          "course_items": {
            "title": "Course Items",
            "type": "integer"
          },
          "in_review": {
            "title": "In Review",
            "type": "integer"
          },
          "introduced": {
            "title": "Introduced",
            "type": "integer"
          },
          "learning": {
            "title": "Learning",
            "type": "integer"
          },
          "learning_due": {
            "title": "Learning Due",
            "type": "integer"
          },
          "recent_error_rate": {
            "title": "Recent Error Rate",
            "type": "number"
          },
          "review_due": {
            "title": "Review Due",
            "type": "integer"
          }
        },
        "required": [
          "introduced",
          "learning",
          "in_review",
          "learning_due",
          "review_due",
          "recent_error_rate",
          "course_items"
        ],
        "title": "ProgressResponse",
        "type": "object"
      },
      "RecoveryCodeSignInRequest": {
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "RecoveryCodeSignInRequest",
        "type": "object"
      },
      "RecoveryCodeStatusResponse": {
        "properties": {
          "remaining": {
            "title": "Remaining",
            "type": "integer"
          }
        },
        "required": [
          "remaining"
        ],
        "title": "RecoveryCodeStatusResponse",
        "type": "object"
      },
      "RecoveryCodesResponse": {
        "properties": {
          "codes": {
            "items": {
              "type": "string"
            },
            "title": "Codes",
            "type": "array"
          }
        },
        "required": [
          "codes"
        ],
        "title": "RecoveryCodesResponse",
        "type": "object"
      },
      "RegisteredPasskeyResponse": {
        "description": "A new passkey. The first one also brings the recovery codes, which are shown once.",
        "properties": {
          "passkey": {
            "$ref": "#/components/schemas/PasskeyResponse"
          },
          "recovery_codes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recovery Codes"
          }
        },
        "required": [
          "passkey",
          "recovery_codes"
        ],
        "title": "RegisteredPasskeyResponse",
        "type": "object"
      },
      "RegistrationVerifyRequest": {
        "description": "The browser's new passkey, as its WebAuthn API produced it.",
        "properties": {
          "credential": {
            "$ref": "#/components/schemas/PasskeyJson"
          },
          "label": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          }
        },
        "required": [
          "credential"
        ],
        "title": "RegistrationVerifyRequest",
        "type": "object"
      },
      "ReportedOutcome": {
        "description": "How the learner says an exercise went.",
        "enum": [
          "got_it",
          "missed_it"
        ],
        "title": "ReportedOutcome",
        "type": "string"
      },
      "TopicResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "requires": {
            "items": {
              "type": "string"
            },
            "title": "Requires",
            "type": "array"
          }
        },
        "required": [
          "name",
          "requires"
        ],
        "title": "TopicResponse",
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_guest": {
            "title": "Is Guest",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "is_guest",
          "created_at"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Dyfal donc",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/guest": {
      "post": {
        "operationId": "post_guest_auth_guest_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Post Guest"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "post_logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Post Logout"
      }
    },
    "/auth/passkeys/authentication/options": {
      "post": {
        "operationId": "post_authentication_options_auth_passkeys_authentication_options_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyJson"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Post Authentication Options"
      }
    },
    "/auth/passkeys/authentication/verify": {
      "post": {
        "operationId": "post_authentication_verify_auth_passkeys_authentication_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Authentication Verify"
      }
    },
    "/auth/passkeys/registration/options": {
      "post": {
        "operationId": "post_registration_options_auth_passkeys_registration_options_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyJson"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Post Registration Options"
      }
    },
    "/auth/passkeys/registration/verify": {
      "post": {
        "operationId": "post_registration_verify_auth_passkeys_registration_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredPasskeyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Registration Verify"
      }
    },
    "/auth/recovery/verify": {
      "post": {
        "operationId": "post_recovery_verify_auth_recovery_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryCodeSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Recovery Verify"
      }
    },
    "/course": {
      "get": {
        "operationId": "course_course_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Course"
      }
    },
    "/exercises/{exercise_id}/audio/{track}": {
      "get": {
        "operationId": "get_audio_exercises__exercise_id__audio__track__get",
        "parameters": [
          {
            "in": "path",
            "name": "exercise_id",
            "required": true,
            "schema": {
              "title": "Exercise Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "track",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AudioTrack"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "audio/wav": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Audio"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/me": {
      "delete": {
        "operationId": "delete_me_me_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Delete Me"
      },
      "get": {
        "operationId": "get_me_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Me"
      }
    },
    "/me/next": {
      "post": {
        "description": "Issues an exercise to the signed-in learner, so it is not a safe request.",
        "operationId": "post_next_me_next_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextExerciseResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Post Next"
      }
    },
    "/me/outcomes": {
      "post": {
        "operationId": "post_outcome_me_outcomes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutcomeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutcomeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Outcome"
      }
    },
    "/me/passkeys": {
      "get": {
        "operationId": "get_passkeys_me_passkeys_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PasskeyResponse"
                  },
                  "title": "Response Get Passkeys Me Passkeys Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Passkeys"
      }
    },
    "/me/passkeys/{passkey_id}": {
      "delete": {
        "operationId": "delete_passkey_me_passkeys__passkey_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "passkey_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Passkey Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Passkey"
      }
    },
    "/me/progress": {
      "get": {
        "operationId": "get_progress_me_progress_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Progress"
      }
    },
    "/me/recovery-codes": {
      "get": {
        "operationId": "get_recovery_codes_me_recovery_codes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodeStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Recovery Codes"
      },
      "post": {
        "description": "Replaces the user's codes with a new set, shown only in this response.",
        "operationId": "post_recovery_codes_me_recovery_codes_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Post Recovery Codes"
      }
    }
  }
}
