{
  "components": {
    "schemas": {
      "AudioLinks": {
        "description": "Where to fetch each track of an exercise, as paths on this API.",
        "properties": {
          "english": {
            "title": "English",
            "type": "string"
          },
          "welsh": {
            "$ref": "#/components/schemas/WelshAudioLinks"
          }
        },
        "required": [
          "english",
          "welsh"
        ],
        "title": "AudioLinks",
        "type": "object"
      },
      "AuthenticationVerifyRequest": {
        "description": "The browser's signed answer, as its WebAuthn API produced it.",
        "properties": {
          "credential": {
            "$ref": "#/components/schemas/PasskeyJson"
          }
        },
        "required": [
          "credential"
        ],
        "title": "AuthenticationVerifyRequest",
        "type": "object"
      },
      "CourseProgressResponse": {
        "description": "Every topic in the order it is taught.",
        "properties": {
          "topics": {
            "items": {
              "$ref": "#/components/schemas/TopicProgressResponse"
            },
            "title": "Topics",
            "type": "array"
          }
        },
        "required": [
          "topics"
        ],
        "title": "CourseProgressResponse",
        "type": "object"
      },
      "CourseResponse": {
        "properties": {
          "item_count": {
            "title": "Item Count",
            "type": "integer"
          },
          "release": {
            "title": "Release",
            "type": "string"
          },
          "topics": {
            "items": {
              "$ref": "#/components/schemas/TopicResponse"
            },
            "title": "Topics",
            "type": "array"
          }
        },
        "required": [
          "release",
          "item_count",
          "topics"
        ],
        "title": "CourseResponse",
        "type": "object"
      },
      "ExercisePurpose": {
        "description": "Why an exercise was chosen.",
        "enum": [
          "learning_due",
          "review_due",
          "introduction",
          "practice"
        ],
        "title": "ExercisePurpose",
        "type": "string"
      },
      "ExerciseResponse": {
        "description": "An exercise to do. Quote ``selection_id`` back when reporting the outcome.",
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/AudioLinks"
          },
          "english": {
            "title": "English",
            "type": "string"
          },
          "introduces": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Introduces"
          },
          "item_ids": {
            "items": {
              "type": "string"
            },
            "title": "Item Ids",
            "type": "array"
          },
          "kind": {
            "const": "exercise",
            "default": "exercise",
            "title": "Kind",
            "type": "string"
          },
          "purpose": {
            "$ref": "#/components/schemas/ExercisePurpose"
          },
          "selection_id": {
            "format": "uuid",
            "title": "Selection Id",
            "type": "string"
          },
          "welsh": {
            "title": "Welsh",
            "type": "string"
          }
        },
        "required": [
          "selection_id",
          "english",
          "welsh",
          "audio",
          "item_ids",
          "introduces",
          "purpose"
        ],
        "title": "ExerciseResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ItemDetailResponse": {
        "description": "An item the learner has met, with sentences they got right.\n\n``audio`` is where to hear a word, and is null for a phrase, whose sentences\ncarry the audio instead.",
        "properties": {
          "audio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio"
          },
          "english": {
            "title": "English",
            "type": "string"
          },
          "examples": {
            "items": {
              "$ref": "#/components/schemas/SentenceResponse"
            },
            "title": "Examples",
            "type": "array"
          },
          "first_met_at": {
            "format": "date-time",
            "title": "First Met At",
            "type": "string"
          },
          "forms": {
            "items": {
              "type": "string"
            },
            "title": "Forms",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ItemKind"
          },
          "notes": {
            "title": "Notes",
            "type": "string"
          },
          "topic": {
            "title": "Topic",
            "type": "string"
          },
          "welsh": {
            "title": "Welsh",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "welsh",
          "english",
          "topic",
          "forms",
          "notes",
          "first_met_at",
          "audio",
          "examples"
        ],
        "title": "ItemDetailResponse",
        "type": "object"
      },
      "ItemKind": {
        "description": "A single word, or a way of saying things with a slot to fill.",
        "enum": [
          "word",
          "phrase"
        ],
        "title": "ItemKind",
        "type": "string"
      },
      "ItemResponse": {
        "description": "A word or pattern the learner met, in both languages.",
        "properties": {
          "english": {
            "title": "English",
            "type": "string"
          },
          "forms": {
            "items": {
              "type": "string"
            },
            "title": "Forms",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "welsh": {
            "title": "Welsh",
            "type": "string"
          }
        },
        "required": [
          "id",
          "welsh",
          "english",
          "forms"
        ],
        "title": "ItemResponse",
        "type": "object"
      },
      "NextExerciseResponse": {
        "discriminator": {
          "mapping": {
            "exercise": "#/components/schemas/ExerciseResponse",
            "nothing_eligible": "#/components/schemas/NothingEligibleResponse"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/ExerciseResponse"
          },
          {
            "$ref": "#/components/schemas/NothingEligibleResponse"
          }
        ]
      },
      "NothingEligibleResponse": {
        "description": "There is no exercise to give: the course has a gap or is empty.",
        "properties": {
          "kind": {
            "const": "nothing_eligible",
            "default": "nothing_eligible",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "NothingEligibleResponse",
        "type": "object"
      },
      "OutcomeRequest": {
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/ReportedOutcome"
          },
          "selection_id": {
            "format": "uuid",
            "title": "Selection Id",
            "type": "string"
          }
        },
        "required": [
          "selection_id",
          "outcome"
        ],
        "title": "OutcomeRequest",
        "type": "object"
      },
      "OutcomeResponse": {
        "description": "``recorded`` is false when this outcome had already been recorded.",
        "properties": {
          "recorded": {
            "title": "Recorded",
            "type": "boolean"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": [
          "sequence",
          "recorded"
        ],
        "title": "OutcomeResponse",
        "type": "object"
      },
      "OverviewResponse": {
        "description": "What the home screen shows, as of ``now`` on the server's clock.\n\n``new_words_ready`` says the course has more words to introduce. The scheduler may\nstill slow them down after recent misses. ``topic`` is the topic the next new word\nbelongs to, and is null when the course is finished.",
        "properties": {
          "course_items": {
            "title": "Course Items",
            "type": "integer"
          },
          "introduced": {
            "title": "Introduced",
            "type": "integer"
          },
          "latest_session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionRecapResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "learning_due": {
            "title": "Learning Due",
            "type": "integer"
          },
          "new_words_ready": {
            "title": "New Words Ready",
            "type": "boolean"
          },
          "now": {
            "format": "date-time",
            "title": "Now",
            "type": "string"
          },
          "review_due": {
            "title": "Review Due",
            "type": "integer"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic"
          }
        },
        "required": [
          "now",
          "review_due",
          "learning_due",
          "new_words_ready",
          "topic",
          "introduced",
          "course_items",
          "latest_session"
        ],
        "title": "OverviewResponse",
        "type": "object"
      },
      "PasskeyJson": {
        "additionalProperties": true,
        "type": "object"
      },
      "PasskeyResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          }
        },
        "required": [
          "id",
          "label",
          "created_at",
          "last_used_at"
        ],
        "title": "PasskeyResponse",
        "type": "object"
      },
      "ProgressResponse": {
        "description": "Where the learner is, as of the server's clock.",
        "properties": {
          "course_items": {
            "title": "Course Items",
            "type": "integer"
          },
          "in_review": {
            "title": "In Review",
            "type": "integer"
          },
          "introduced": {
            "title": "Introduced",
            "type": "integer"
          },
          "learning": {
            "title": "Learning",
            "type": "integer"
          },
          "learning_due": {
            "title": "Learning Due",
            "type": "integer"
          },
          "recent_error_rate": {
            "title": "Recent Error Rate",
            "type": "number"
          },
          "review_due": {
            "title": "Review Due",
            "type": "integer"
          }
        },
        "required": [
          "introduced",
          "learning",
          "in_review",
          "learning_due",
          "review_due",
          "recent_error_rate",
          "course_items"
        ],
        "title": "ProgressResponse",
        "type": "object"
      },
      "RecoveryCodeSignInRequest": {
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "RecoveryCodeSignInRequest",
        "type": "object"
      },
      "RecoveryCodeStatusResponse": {
        "properties": {
          "remaining": {
            "title": "Remaining",
            "type": "integer"
          }
        },
        "required": [
          "remaining"
        ],
        "title": "RecoveryCodeStatusResponse",
        "type": "object"
      },
      "RecoveryCodesResponse": {
        "properties": {
          "codes": {
            "items": {
              "type": "string"
            },
            "title": "Codes",
            "type": "array"
          }
        },
        "required": [
          "codes"
        ],
        "title": "RecoveryCodesResponse",
        "type": "object"
      },
      "RegisteredPasskeyResponse": {
        "description": "A new passkey. The first one also brings the recovery codes, which are shown once.",
        "properties": {
          "passkey": {
            "$ref": "#/components/schemas/PasskeyResponse"
          },
          "recovery_codes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recovery Codes"
          }
        },
        "required": [
          "passkey",
          "recovery_codes"
        ],
        "title": "RegisteredPasskeyResponse",
        "type": "object"
      },
      "RegistrationVerifyRequest": {
        "description": "The browser's new passkey, as its WebAuthn API produced it.",
        "properties": {
          "credential": {
            "$ref": "#/components/schemas/PasskeyJson"
          },
          "label": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          }
        },
        "required": [
          "credential"
        ],
        "title": "RegistrationVerifyRequest",
        "type": "object"
      },
      "ReportedOutcome": {
        "description": "How the learner says an exercise went.",
        "enum": [
          "got_it",
          "missed_it"
        ],
        "title": "ReportedOutcome",
        "type": "string"
      },
      "SentenceResponse": {
        "description": "An exercise as a sentence in both languages, with its audio.",
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/AudioLinks"
          },
          "english": {
            "title": "English",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "welsh": {
            "title": "Welsh",
            "type": "string"
          }
        },
        "required": [
          "id",
          "english",
          "welsh",
          "audio"
        ],
        "title": "SentenceResponse",
        "type": "object"
      },
      "SessionRecapResponse": {
        "description": "A short account of one learning session.\n\n``id`` is the number of the session's first answer in the learner's log, and\n``ongoing`` says the last answer was recent enough that it may carry on.",
        "properties": {
          "duration_seconds": {
            "title": "Duration Seconds",
            "type": "integer"
          },
          "ended_at": {
            "format": "date-time",
            "title": "Ended At",
            "type": "string"
          },
          "exercises_completed": {
            "title": "Exercises Completed",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "items_introduced": {
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            },
            "title": "Items Introduced",
            "type": "array"
          },
          "ongoing": {
            "title": "Ongoing",
            "type": "boolean"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "started_at",
          "ended_at",
          "duration_seconds",
          "ongoing",
          "exercises_completed",
          "items_introduced"
        ],
        "title": "SessionRecapResponse",
        "type": "object"
      },
      "SessionSummaryResponse": {
        "description": "All of a learning session: the recap, and what was reviewed, forgotten and missed.",
        "properties": {
          "duration_seconds": {
            "title": "Duration Seconds",
            "type": "integer"
          },
          "ended_at": {
            "format": "date-time",
            "title": "Ended At",
            "type": "string"
          },
          "exercises_completed": {
            "title": "Exercises Completed",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "items_introduced": {
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            },
            "title": "Items Introduced",
            "type": "array"
          },
          "items_lapsed": {
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            },
            "title": "Items Lapsed",
            "type": "array"
          },
          "items_reviewed": {
            "title": "Items Reviewed",
            "type": "integer"
          },
          "missed_exercises": {
            "items": {
              "$ref": "#/components/schemas/SentenceResponse"
            },
            "title": "Missed Exercises",
            "type": "array"
          },
          "ongoing": {
            "title": "Ongoing",
            "type": "boolean"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "started_at",
          "ended_at",
          "duration_seconds",
          "ongoing",
          "exercises_completed",
          "items_introduced",
          "items_reviewed",
          "items_lapsed",
          "missed_exercises"
        ],
        "title": "SessionSummaryResponse",
        "type": "object"
      },
      "TopicProgressResponse": {
        "description": "What the learner has met in one topic.\n\nA topic that has not been started has no words, phrases or sentences. The\nsentences are some the learner has got right.",
        "properties": {
          "exercises_answered": {
            "title": "Exercises Answered",
            "type": "integer"
          },
          "is_current": {
            "title": "Is Current",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "phrases": {
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            },
            "title": "Phrases",
            "type": "array"
          },
          "sayable": {
            "items": {
              "$ref": "#/components/schemas/SentenceResponse"
            },
            "title": "Sayable",
            "type": "array"
          },
          "started": {
            "title": "Started",
            "type": "boolean"
          },
          "words": {
            "items": {
              "$ref": "#/components/schemas/ItemResponse"
            },
            "title": "Words",
            "type": "array"
          }
        },
        "required": [
          "name",
          "started",
          "is_current",
          "exercises_answered",
          "words",
          "phrases",
          "sayable"
        ],
        "title": "TopicProgressResponse",
        "type": "object"
      },
      "TopicResponse": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "requires": {
            "items": {
              "type": "string"
            },
            "title": "Requires",
            "type": "array"
          }
        },
        "required": [
          "name",
          "requires"
        ],
        "title": "TopicResponse",
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_guest": {
            "title": "Is Guest",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "is_guest",
          "created_at"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "UserSettingsPatch": {
        "description": "Settings to change. A field that is left out stays as it is.",
        "properties": {
          "think_time_multiplier": {
            "default": 1.0,
            "maximum": 3.0,
            "minimum": 0.5,
            "title": "Think Time Multiplier",
            "type": "number"
          },
          "welsh_playback": {
            "$ref": "#/components/schemas/WelshPlayback",
            "default": "both"
          }
        },
        "title": "UserSettingsPatch",
        "type": "object"
      },
      "UserSettingsResponse": {
        "description": "The settings in force. A user has ``DEFAULT_USER_SETTINGS`` until they save some.\n\n``welsh_playback`` is which Welsh recordings play: the woman's at a standard pace,\nthe man's slowly, or hers and then his.",
        "properties": {
          "think_time_multiplier": {
            "maximum": 3.0,
            "minimum": 0.5,
            "title": "Think Time Multiplier",
            "type": "number"
          },
          "welsh_playback": {
            "$ref": "#/components/schemas/WelshPlayback"
          }
        },
        "required": [
          "think_time_multiplier",
          "welsh_playback"
        ],
        "title": "UserSettingsResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WelshAudioLinks": {
        "properties": {
          "slow": {
            "title": "Slow",
            "type": "string"
          },
          "standard": {
            "title": "Standard",
            "type": "string"
          }
        },
        "required": [
          "standard",
          "slow"
        ],
        "title": "WelshAudioLinks",
        "type": "object"
      },
      "WelshPace": {
        "description": "How fast the Welsh is spoken: by a woman at a standard pace, or by a man slowly.",
        "enum": [
          "standard",
          "slow"
        ],
        "title": "WelshPace",
        "type": "string"
      },
      "WelshPlayback": {
        "enum": [
          "standard",
          "slow",
          "both"
        ],
        "title": "WelshPlayback",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Dyfal donc",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/guest": {
      "post": {
        "operationId": "post_guest_auth_guest_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Post Guest"
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "post_logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Post Logout"
      }
    },
    "/auth/passkeys/authentication/options": {
