import { readFile, writeFile } from "node:fs/promises";
import openapiTS, { astToString } from "openapi-typescript";

const SCHEMA_URL = new URL("../openapi.json", import.meta.url);
const TYPES_URL = new URL("../src/api/schema.d.ts", import.meta.url);
const HEADER = "// Generated by `pnpm types` from openapi.json. Do not edit it.\n\n";

const generated = HEADER + astToString(await openapiTS(SCHEMA_URL, { defaultNonNullable: false }));

if (process.argv.includes("--check")) {
  const committed = await readFile(TYPES_URL, "utf8").catch(() => "");

  if (committed !== generated) {
    console.error("src/api/schema.d.ts is out of date. Run `make web-types`.");
    process.exit(1);
  }
} else {
  await writeFile(TYPES_URL, generated);
}
