# Copy to .env, which is not committed. Docker Compose and the app both read it.
# These are the credentials of the local development database.
POSTGRES_USER=dyfal
POSTGRES_PASSWORD=dyfal
POSTGRES_DB=dyfal
POSTGRES_PORT=5432
WEB_PORT=8080
API_PORT=8000
TTS_PORT=8001

# How code running outside Docker (poe api, poe db-create) reaches that database.
# It must agree with the POSTGRES_ values above.
DATABASE_URL=postgresql+psycopg://dyfal:dyfal@localhost:5432/dyfal # pragma: allowlist secret

# How code running outside Docker reaches the speech service (make tts-up).
TTS_URL=http://localhost:8001

# Passkeys are bound to this domain: changing it makes every existing passkey unusable.
# The origins are the addresses the app is served from: nginx, and `make web-dev`.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=dyfal-donc
WEBAUTHN_ORIGINS=http://localhost:8080,http://localhost:3000

# Off only for local development over plain HTTP. Anywhere else the cookie must be Secure.
SESSION_COOKIE_SECURE=false
# How long a sign-in lasts without being used: a day for an account with a passkey, and
# longer for a guest, who has no passkey to get back in with.
SESSION_LIFETIME_SECONDS=86400
SESSION_GUEST_LIFETIME_SECONDS=2592000
